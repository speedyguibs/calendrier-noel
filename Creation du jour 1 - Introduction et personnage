
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notre aventure de Noël</title>

<style>

:root {
    --red: #a51e32;
    --dark-red: #65101f;
    --gold: #d4ac63;
    --light-gold: #f4dda5;
    --cream: #fffaf1;
    --text: #751c2a;
    --muted: #79534b;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Georgia, serif;
    color: var(--cream);
    background: radial-gradient(
        ellipse at top,
        #ce505c,
        transparent 55%
    ), linear-gradient(#a51e32, #65101f);
    background-attachment: fixed;
}

button, input {
    font: inherit;
}

button {
    cursor: pointer;
    touch-action: manipulation;
}

button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.container {
    max-width: 720px;
    margin: auto;
    padding: 20px 16px 115px;
    position: relative;
    z-index: 2;
}

.snow {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
}

.snowflake {
    position: absolute;
    top: -30px;
    color: white;
    animation: fall linear infinite;
}

@keyframes fall {
    to {
        transform: translateY(115vh) rotate(360deg);
    }
}

.garland {
    display: flex;
    justify-content: space-around;
    height: 35px;
    align-items: center;
    border-top: 2px solid #d4ac6388;
    border-radius: 0 0 50% 50%;
    margin-bottom: 18px;
}

.bulb {
    width: 8px;
    height: 12px;
    border-radius: 50%;
    background: #ffe5ad;
    box-shadow: 0 0 15px #ffe5ad;
    animation: glow 2s alternate infinite;
}

.bulb:nth-child(2n) {
    animation-delay: 1s;
}

@keyframes glow {
    from { opacity: .45; }
    to { opacity: 1; }
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: var(--light-gold);
    font-size: 12px;
}

.profile-button {
    background: #65101f88;
    border: 1px solid var(--gold);
    color: var(--cream);
    border-radius: 25px;
    padding: 10px 15px;
    max-width: 65%;
    overflow-wrap: anywhere;
}

.key-counter {
    border: 1px solid var(--gold);
    border-radius: 25px;
    padding: 10px 15px;
    background: #65101f88;
    white-space: nowrap;
}

.hero {
    text-align: center;
    padding: 30px 5px;
}

.chapter {
    color: var(--light-gold);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 11px;
}

h1 {
    font-weight: normal;
    font-size: clamp(34px, 8vw, 58px);
    margin: 20px 0;
    line-height: 1.1;
}

.hero p {
    color: #f4ded4;
    line-height: 1.8;
    font-size: 15px;
}

.hero-treasure {
    width: 175px;
    margin: 25px auto;
    animation: float 4s ease-in-out infinite;
    filter: drop-shadow(0 0 20px #e8c47b55);
}

@keyframes float {
    50% { transform: translateY(-7px); }
}

.panel {
    background: var(--cream);
    color: var(--text);
    border: 1px solid var(--gold);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 25px;
    box-shadow: 0 8px 25px #350a1933;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 14px;
}

.progress-bar {
    height: 8px;
    background: #ead9c2;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 15px;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(
        90deg, #a51e32, #d4ac63
    );
    transition: width .5s;
}

.section-title {
    color: var(--light-gold);
    font-size: 13px;
    letter-spacing: 3px;
    text-align: center;
    margin: 30px 0 18px;
}

.calendar {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 9px;
    background: var(--cream);
    border: 1px solid var(--gold);
    border-radius: 18px;
    padding: 12px;
}

.day {
    min-width: 0;
    aspect-ratio: .82;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 5px;
    color: var(--text);
    background: linear-gradient(#fffaf1, #edddc6);
    border: 1px solid #dbc2a0;
    border-radius: 12px;
    transition: transform .2s;
    box-shadow: 0 3px 7px #805b3220;
}

.day:hover {
    transform: translateY(-3px);
}

.day-number {
    font-size: 21px;
}

.chest {
    width: 85%;
    max-width: 75px;
}

.day-status {
    font-size: 11px;
}

.day.locked .chest {
    opacity: .75;
}

.day.available {
    background: linear-gradient(#fff3d3, #e8c881);
    border: 2px solid #bc9046;
    box-shadow: 0 0 12px #d4ac6380;
}

.day.completed {
    background: #f0d9a5;
    border-color: #b68c49;
}

.day.completed .day-status {
    color: #52734b;
}

.day.final {
    color: var(--cream);
    background: linear-gradient(#b3313f, #751c2a);
    border: 2px solid var(--gold);
}

.footer-text {
    color: #f2dbcf;
    font-style: italic;
    font-size: 13px;
    line-height: 1.8;
    text-align: center;
    margin: 35px 0;
}

.screen {
    display: none;
}

.screen.active {
    display: block;
}

.navigation {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background: var(--cream);
    border-top: 2px solid var(--gold);
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 12px 10px;
    padding-bottom: calc(
        12px + env(safe-area-inset-bottom)
    );
}

.nav-button {
    background: transparent;
    border: none;
    color: #96775e;
    padding: 5px;
    width: 110px;
    font-size: 12px;
}

.nav-button span {
    display: block;
    font-size: 24px;
    margin-bottom: 5px;
}

.nav-button.active {
    color: var(--red);
    font-weight: bold;
}

.collection {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 20px;
}

.collectible {
    background: #f5e8d7;
    border: 1px solid #d8bf9c;
    border-radius: 10px;
    padding: 15px 5px;
    text-align: center;
}

.collectible.earned {
    background: #f2dfb5;
    border-color: var(--gold);
}

.collectible span {
    display: block;
    font-size: 27px;
    margin-bottom: 6px;
}

.reward {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 16px 0;
    border-bottom: 1px solid #ead9c2;
}

.reward:last-child {
    border: none;
}

.reward small {
    color: var(--muted);
}

.reward.locked {
    opacity: .55;
}

.overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: #350812bb;
    backdrop-filter: blur(6px);
    padding: 15px;
    z-index: 20;
}

.overlay.visible {
    display: flex;
}

.modal {
    width: 100%;
    max-width: 540px;
    max-height: 88vh;
    max-height: 88dvh;
    overflow-y: auto;
    position: relative;
    text-align: center;
    background: var(--cream);
    color: var(--text);
    padding: 35px 23px;
    border: 2px solid var(--gold);
    border-radius: 20px;
    box-shadow: 0 15px 70px #0006;
    animation: appear .3s ease-out;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: scale(.94);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.modal .chapter {
    color: #a17a42;
}

.modal h2 {
    font-size: 29px;
    line-height: 1.2;
    font-weight: normal;
}

.modal p {
    color: var(--muted);
    line-height: 1.8;
}

.close {
    position: absolute;
    right: 10px;
    top: 8px;
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 28px;
}

.gold-button {
    display: block;
    width: 100%;
    margin-top: 16px;
    padding: 15px;
    border: 1px solid var(--gold);
    border-radius: 10px;
    color: var(--cream);
    font-weight: bold;
    background: linear-gradient(#ad2938, #751c2a);
}

.secondary-button {
    background: transparent;
    border: 1px solid #c7a773;
    color: var(--text);
    border-radius: 9px;
    padding: 12px;
    width: 100%;
    margin-top: 12px;
}

.feedback {
    color: var(--red);
    min-height: 20px;
    margin-top: 15px;
    line-height: 1.5;
}

.test-banner {
    background: #fff0ce;
    color: var(--text);
    padding: 12px;
    text-align: center;
    font-size: 12px;
    border-radius: 9px;
    margin-top: 15px;
}

.code-display {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 25px 0;
}

.code-digit {
    width: 48px;
    height: 58px;
    border: 1px solid var(--gold);
    background: #f5e8d7;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
}

.keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    max-width: 270px;
    margin: auto;
}

.keypad button {
    background: #f5e8d7;
    border: 1px solid #c7a773;
    color: var(--text);
    padding: 15px;
    border-radius: 8px;
    font-size: 22px;
}

.keypad button:active {
    background: #e7cc97;
}

.envelope {
    display: block;
    width: 90%;
    max-width: 280px;
    margin: 25px auto;
    animation: float 4s infinite ease-in-out;
    filter: drop-shadow(0 8px 8px #79534b30);
    cursor: pointer;
}

.letter {
    background: #fff9ec;
    border: 1px solid #d8bf9c;
    padding: 20px;
    text-align: left;
    line-height: 1.85;
    margin-top: 20px;
}

.letter p {
    font-size: 15px;
    color: #614238;
    margin-bottom: 20px;
}

.letter-signature {
    color: var(--red) !important;
    font-style: italic;
}

.rules {
    text-align: left;
    background: #f5e8d7;
    padding: 8px 15px;
    border-radius: 12px;
    border: 1px solid #d8bf9c;
}

.rule {
    padding: 13px 0;
    border-bottom: 1px solid #ddc9ad;
    font-size: 14px;
    line-height: 1.6;
}

.rule:last-child {
    border: none;
}

.rule strong {
    display: block;
    margin-bottom: 4px;
}

.avatar-preview {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    background: #f0dfbd;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 55px;
    margin: 25px auto;
}

.avatar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 9px;
    margin: 20px 0;
}

.avatar-option {
    aspect-ratio: 1;
    border: 1px solid #decab0;
    border-radius: 12px;
    background: #f5e8d7;
    font-size: 30px;
}

.avatar-option.selected {
    background: #efd9aa;
    border: 2px solid #ad7636;
}

.answer {
    width: 100%;
    padding: 15px;
    background: #f5e8d7;
    color: var(--text);
    border: 1px solid var(--gold);
    border-radius: 9px;
    font-size: 17px;
    text-align: center;
}

.step-indicator {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin: 15px 0 25px;
}

.step-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e1d0b5;
}

.step-dot.active {
    background: var(--red);
}

.step-dot.done {
    background: var(--gold);
}

@media (max-width: 400px) {
    .container {
        padding-left: 12px;
        padding-right: 12px;
    }
    .calendar {
        padding: 8px;
        gap: 5px;
    }
    .day-number {
        font-size: 17px;
    }
    .day-status {
        font-size: 9px;
    }
    .modal {
        padding: 30px 17px;
    }
    .letter {
        padding: 15px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation: none !important;
        transition: none !important;
    }
    .snow {
        display: none;
    }
}

</style>
</head>

<body>

<div class="snow" id="snow" aria-hidden="true"></div>

<main class="container">

    <div class="garland" id="garland"
         aria-hidden="true"></div>

    <div class="topbar">

        <button class="profile-button"
                id="profileButton"
                onclick="openProfile()">
            ✦ NOËL 2026 ✦
        </button>

        <div class="key-counter">
            🔑 <span id="keyCount">0</span> / 24
        </div>

    </div>

    <div id="testBanner"></div>

    <!-- ACCUEIL -->

    <section class="screen active" id="adventure">

        <header class="hero">

            <div class="chapter">
                Une aventure de décembre
            </div>

            <div class="hero-treasure"
                 id="heroChest"></div>

            <h1>Notre aventure<br>de Noël</h1>

            <div style="color:#f4dda5">
                ✦　❄　✦
            </div>

            <p>
                25 missions. 24 clés. Un dernier secret.
                <br><br>
                Une aventure imaginée pour nous,
                malgré les kilomètres.
            </p>

        </header>

        <div class="panel">

            <div class="progress-info">
                <span>Ton aventure</span>
                <span id="progressText">0 / 25 coffres</span>
            </div>

            <div class="progress-bar">
                <div class="progress-fill"
                     id="progressFill"></div>
            </div>

        </div>

        <div class="section-title">
            ✦ LES 25 COFFRES ✦
        </div>

        <div class="calendar" id="calendar"></div>

        <div class="footer-text">
            Les plus belles aventures<br>
            ne se mesurent pas en kilomètres.
        </div>

    </section>

    <!-- INVENTAIRE -->

    <section class="screen" id="inventory">

        <header class="hero">

            <div class="chapter">Ta collection</div>

            <div style="font-size:65px;margin:20px">
                🔑
            </div>

            <h1>L'inventaire</h1>

            <p>
                Chaque mission accomplie
                te rapproche du dernier trésor.
            </p>

        </header>

        <div class="panel">

            <div class="progress-info">
                <span>Clés collectées</span>
                <span id="inventoryCount">0 / 24</span>
            </div>

            <div class="collection" id="collection"></div>

        </div>

    </section>

    <!-- RECOMPENSES -->

    <section class="screen" id="rewards">

        <header class="hero">

            <div class="chapter">
                Les trésors de décembre
            </div>

            <div style="font-size:65px;margin:20px">
                🏆
            </div>

            <h1>Tes récompenses</h1>

            <p>
                Collectionne les trophées
                tout au long de ton aventure.
            </p>

        </header>

        <div class="panel" id="rewardList"></div>

    </section>

</main>

<!-- NAVIGATION -->

<nav class="navigation">

    <button class="nav-button active"
            onclick="showScreen('adventure',this)">
        <span>🧭</span>
        Aventure
    </button>

    <button class="nav-button"
            onclick="showScreen('inventory',this)">
        <span>🔑</span>
        Inventaire
    </button>

    <button class="nav-button"
            onclick="showScreen('rewards',this)">
        <span>🏆</span>
        Récompenses
    </button>

</nav>

<!-- FENETRES INTERACTIVES -->

<div class="overlay" id="overlay">

    <div class="modal"
         role="dialog"
         aria-modal="true"
         aria-label="Mission de Noël">

        <button class="close"
                aria-label="Fermer"
                onclick="closeModal()">×</button>

        <div id="modalContent"></div>

    </div>

</div>

<script>

// =====================================
// PARAMETRES GENERAUX
// =====================================

const testMode =
    new URLSearchParams(location.search)
    .get("test") === "1";

const storageKey = testMode
    ? "noel2026-test"
    : "noel2026-progression";

const profileKey = storageKey + "-profile";

const introKey = storageKey + "-intro";

const SECRET_CODE = "8922";

const avatars = [
    "🦊", "🐻", "🐨", "🐧",
    "🐰", "🐱", "🦌", "🦉"
];

function readStorage(key, fallback) {
    try {
        const value = localStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
    } catch (error) {
        return fallback;
    }
}

function saveStorage(key, value) {
    try {
        localStorage.setItem(key, JSON.stringify(value));
    } catch (error) {
        alert("La sauvegarde est indisponible dans ce navigateur.");
    }
}

let saved = readStorage(storageKey, []);

let completed = Array.isArray(saved)
    ? [...new Set(saved.filter(
        n => Number.isInteger(n) && n >= 1 && n <= 25
    ))]
    : [];

let profile = readStorage(profileKey, null);

if (
    !profile ||
    typeof profile.name !== "string" ||
    !avatars.includes(profile.avatar)
) {
    profile = null;
}

let introStage = readStorage(introKey, 0);

if (![0, 1, 2, 3].includes(introStage)) {
    introStage = 0;
}

let code = "";
let chosenAvatar = profile ? profile.avatar : avatars[0];
let editingProfile = false;

// Retirer l'ancienne validation du jour 1
// si elle provenait uniquement du jeu de démonstration.

if (
    completed.includes(1) &&
    (!profile || introStage !== 3)
) {
    completed = completed.filter(n => n !== 1);
    saveStorage(storageKey, completed);
}

if (testMode) {

    document.getElementById("testBanner").innerHTML = `
        <div class="test-banner">
            MODE CRÉATION — Tous les coffres sont accessibles.
            <br>
            <button class="secondary-button"
                    onclick="resetTest()">
                Réinitialiser mes tests
            </button>
        </div>
    `;

}


// =====================================
// DECORATIONS
// =====================================

for (let i = 0; i < 12; i++) {
    const bulb = document.createElement("span");
    bulb.className = "bulb";
    document.getElementById("garland").appendChild(bulb);
}

for (let i = 0; i < 40; i++) {

    const flake = document.createElement("span");

    flake.className = "snowflake";
    flake.textContent = ["❄", "✦", "•"][i % 3];
    flake.style.left = Math.random() * 100 + "%";
    flake.style.fontSize = 6 + Math.random() * 12 + "px";
    flake.style.opacity = .3 + Math.random() * .6;
    flake.style.animationDuration =
        9 + Math.random() * 15 + "s";
    flake.style.animationDelay =
        -Math.random() * 20 + "s";

    document.getElementById("snow").appendChild(flake);

}


// =====================================
// ILLUSTRATION DES COFFRES
// =====================================

let chestCounter = 0;

function chestSVG(final = false, open = false) {

    const id = "chest" + (++chestCounter);

    return `
    <svg viewBox="0 0 120 100" width="100%"
         xmlns="http://www.w3.org/2000/svg">

        <defs>

            <linearGradient id="${id}red"
                x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%"
                      stop-color="${final ? "#c9434d" : "#ba3443"}"/>
                <stop offset="100%"
                      stop-color="#751022"/>
            </linearGradient>

            <linearGradient id="${id}gold"
                x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#fff0be"/>
                <stop offset="50%" stop-color="#bd9149"/>
                <stop offset="100%" stop-color="#e7c98d"/>
            </linearGradient>

        </defs>

        <ellipse cx="60" cy="91" rx="48" ry="6"
                 fill="#390810" opacity=".2"/>

        <rect x="12" y="42" width="96" height="43"
              rx="5" fill="url(#${id}red)"
              stroke="#c4a36b" stroke-width="2"/>

        ${open ? `
            <path d="M12 35 L23 5 H97 L108 35 Z"
                  fill="url(#${id}red)"
                  stroke="#c4a36b" stroke-width="2"/>
            <ellipse cx="60" cy="42" rx="44" ry="8"
                     fill="#f2d484"/>
            <path d="M28 16 L35 35 M92 16 L85 35"
                  stroke="url(#${id}gold)" stroke-width="7"/>
        ` : `
            <path d="M12 42 V26 Q12 8 32 8
                     H88 Q108 8 108 26 V42 Z"
                  fill="url(#${id}red)"
                  stroke="#c4a36b" stroke-width="2"/>
            <path d="M29 12 V42 M91 12 V42"
                  stroke="url(#${id}gold)" stroke-width="8"/>
        `}

        <path d="M29 47 V85 M91 47 V85"
              stroke="url(#${id}gold)" stroke-width="8"/>

        <path d="M12 43 H108 M12 77 H108"
              stroke="url(#${id}gold)" stroke-width="5"/>

        <rect x="50" y="36" width="20" height="25"
              rx="4" fill="url(#${id}gold)"/>

        <circle cx="60" cy="44" r="4" fill="#674826"/>
        <path d="M60 44 L56 54 H64 Z" fill="#674826"/>

    </svg>`;
}

document.getElementById("heroChest").innerHTML =
    chestSVG(true);


// =====================================
// DATE ET DEBLOCAGE DES MISSIONS
// =====================================

function frenchDate() {

    const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
    }).formatToParts(new Date());

    const value = type =>
        parts.find(p => p.type === type).value;

    return `${value("year")}-${value("month")}-${value("day")}`;
}

function dateAvailable(day) {

    const unlockDate =
        `2026-12-${String(day).padStart(2, "0")}`;

    return frenchDate() >= unlockDate;

}

function previousCompleted(day) {

    for (let i = 1; i < day; i++) {
        if (!completed.includes(i)) return false;
    }

    return true;

}

function available(day) {

    if (testMode) return true;

    return dateAvailable(day) &&
           previousCompleted(day);

}


// =====================================
// CALENDRIER
// =====================================

function renderCalendar() {

    const calendar = document.getElementById("calendar");

    calendar.innerHTML = "";

    for (let day = 1; day <= 25; day++) {

        const done = completed.includes(day);
        const unlocked = available(day);

        const button = document.createElement("button");

        button.className = "day";

        if (day === 25) {
            button.classList.add("final");
        }

        button.classList.add(
            done ? "completed" :
            unlocked ? "available" : "locked"
        );

        button.setAttribute(
            "aria-label",
            `Coffre du ${day} décembre`
        );

        button.innerHTML = `
            <div class="chest">
                ${chestSVG(day === 25, done)}
            </div>

            <div class="day-number">
                ${String(day).padStart(2, "0")}
            </div>

            <div class="day-status">
                ${done ? "✓" : unlocked ? "✦" : "🔒"}
            </div>
        `;

        button.onclick = () => openDay(day);

        calendar.appendChild(button);

    }

}


// =====================================
// OUVERTURE DES COFFRES
// =====================================

function openDay(day) {

    if (!testMode && !dateAvailable(day)) {

        showModal(`
            <div class="chapter">Coffre verrouillé</div>

            <div style="width:140px;margin:25px auto">
                ${chestSVG(day === 25)}
            </div>

            <h2>Encore un peu de patience...</h2>

            <p>
                Ce coffre ne pourra être ouvert
                que le ${day} décembre.
            </p>

            <button class="gold-button"
                    onclick="closeModal()">
                Retour à l'aventure
            </button>
        `);

        return;
    }

    if (!testMode && !previousCompleted(day)) {

        showModal(`
            <div class="chapter">Mission verrouillée</div>

            <div style="font-size:55px;margin:20px">
                🔐
            </div>

            <h2>Il te manque une clé !</h2>

            <p>
                Tu dois terminer les missions précédentes
                avant de pouvoir accéder à ce coffre.
            </p>

            <button class="gold-button"
                    onclick="closeModal()">
                Reprendre mon aventure
            </button>
        `);

        return;
    }

    // JOUR 1

    if (day === 1) {

        if (completed.includes(1)) {

            showModal(`
                <div class="chapter">
                    Chapitre 01 · Terminé
                </div>

                <h2>Là où tout a commencé</h2>

                <div style="width:130px;margin:20px auto">
                    ${chestSVG(false, true)}
                </div>

                <p>
                    Tu as déjà obtenu ta première clé.
                </p>

                <button class="gold-button"
                        onclick="showLetter(true)">
                    Relire ma lettre
                </button>

                <button class="secondary-button"
                        onclick="showRules(true)">
                    Relire les règles
                </button>
            `);

        } else if (introStage === 1) {

            showEnvelope();

        } else if (introStage === 2) {

            showLetter();

        } else {

            showFirstCode();

        }

        return;

    }

    // COFFRE FINAL

    if (day === 25) {

        const keys = completed.filter(
            n => n <= 24
        ).length;

        showModal(`
            <div class="chapter">Le trésor de Noël</div>

            <div style="width:160px;margin:20px auto">
                ${chestSVG(true)}
            </div>

            <h2>Le dernier secret</h2>

            <p>${keys} clés collectées sur 24.</p>

            <p>
                ${keys < 24
                    ? "Il te reste des missions à accomplir."
                    : "Toutes les clés sont réunies !"
                }
            </p>

            <button class="gold-button"
                    onclick="closeModal()">
                Retour
            </button>
        `);

        return;
    }

    if (completed.includes(day)) {

        showModal(`
            <div class="chapter">Mission accomplie</div>
            <h2>Ce coffre est déjà ouvert.</h2>

            <button class="gold-button"
                    onclick="closeModal()">
                Continuer
            </button>
        `);

        return;

    }

    // AUTRES JEUX A PROGRAMMER

    showModal(`
        <div class="chapter">Mission ${day}</div>

        <div style="width:140px;margin:20px auto">
            ${chestSVG()}
        </div>

        <h2>Un nouveau secret</h2>

        <p>
            Cette mission est encore en cours de création.
        </p>

        <button class="gold-button"
                onclick="closeModal()">
            Retour
        </button>
    `);

}


// =====================================
// JOUR 1 - INDICATEUR DES ETAPES
// =====================================

function steps(current) {

    return `
        <div class="step-indicator">
            ${[1,2,3,4,5].map(n => `
                <span class="step-dot
                    ${n === current ? "active" :
                      n < current ? "done" : ""}">
                </span>
            `).join("")}
        </div>
    `;

}


// =====================================
// JOUR 1 - ETAPE 1 : LE CODE SECRET
// =====================================

function showFirstCode() {

    code = "";

    showModal(`

        <div class="chapter">
            Chapitre 01 · Là où tout a commencé
        </div>

        ${steps(1)}

        <div style="font-size:60px;margin:15px">
            🔐
        </div>

        <h2>Tout a commencé un certain jour...</h2>

        <p>
            Avant de commencer cette aventure,
            souviens-toi du jour où nos chemins
            se sont croisés pour la première fois.
        </p>

        <p>
            Cette date renferme le premier secret
            de ton calendrier.
        </p>

        <div class="code-display"
             id="codeDisplay">

            <span class="code-digit">?</span>
            <span class="code-digit">?</span>
            <span class="code-digit">?</span>
            <span class="code-digit">?</span>

        </div>

        <div class="keypad">

            ${[1,2,3,4,5,6,7,8,9].map(n => `
                <button onclick="pressDigit('${n}')">
                    ${n}
                </button>
            `).join("")}

            <button onclick="clearCode()">C</button>

            <button onclick="pressDigit('0')">0</button>

            <button onclick="deleteDigit()">⌫</button>

        </div>

        <button class="gold-button"
                onclick="checkFirstCode()">
            Déverrouiller le secret
        </button>

        <button class="secondary-button"
                onclick="showHint()">
            Besoin d'un indice ?
        </button>

        <div class="feedback" id="feedback"
             aria-live="polite"></div>

    `);

}

function pressDigit(digit) {

    if (code.length < 4) {
        code += digit;
        renderCode();
    }

}

function deleteDigit() {
    code = code.slice(0, -1);
    renderCode();
}

function clearCode() {
    code = "";
    renderCode();
}

function renderCode() {

    document.getElementById("codeDisplay").innerHTML =
        Array.from({length: 4}, (_, i) => `
            <span class="code-digit">
                ${code[i] || "?"}
            </span>
        `).join("");

    document.getElementById("feedback").textContent = "";

}

function showHint() {

    document.getElementById("feedback").textContent =
        "Le jour, le numéro du mois moins un, puis les deux derniers chiffres de l'année.";

}

function checkFirstCode() {

    if (code === SECRET_CODE) {

        introStage = 1;
        saveStorage(introKey, introStage);
        showEnvelope();

    } else {

        document.getElementById("feedback").textContent =
            "Ce n'est pas encore le bon code... Souviens-toi de notre première rencontre.";

    }

}


// =====================================
// JOUR 1 - ETAPE 2 : L'ENVELOPPE
// =====================================

function envelopeSVG() {

    return `
    <svg viewBox="0 0 280 175" width="100%"
         xmlns="http://www.w3.org/2000/svg">

        <rect x="10" y="15" width="260" height="145"
              rx="6" fill="#ecdbbc"
              stroke="#bd9a63" stroke-width="2"/>

        <path d="M10 160 L140 60 L270 160"
              fill="#f6e8ce" stroke="#c7a773"/>

        <path d="M10 15 L140 115 L270 15Z"
              fill="#fff2d9" stroke="#c7a773"/>

        <circle cx="140" cy="108" r="26"
                fill="#8e2030"
                stroke="#b9454e" stroke-width="3"/>

        <circle cx="140" cy="108" r="19"
                fill="none" stroke="#d27b78"/>

        <text x="140" y="117"
              font-size="27"
              fill="#f0c9ae"
              text-anchor="middle">♥</text>

    </svg>`;
}

function showEnvelope() {

    showModal(`

        <div class="chapter">Code accepté</div>

        ${steps(2)}

        <h2>Une lettre t'attend...</h2>

        <p>
            Félicitations, tu te souviens encore
            du jour où tout a commencé.
        </p>

        <button class="envelope"
                style="border:none;background:transparent"
                aria-label="Ouvrir l'enveloppe"
                onclick="showLetter()">

            ${envelopeSVG()}

        </button>

        <p>
            Expéditeur : ton petit ange gardien.
            <br>
            Destinataire : une personne très spéciale.
        </p>

        <button class="gold-button"
                onclick="showLetter()">
            Ouvrir mon enveloppe
        </button>

    `);

}


// =====================================
// JOUR 1 - ETAPE 3 : LA LETTRE
// =====================================

