                <br><br>
                Ton petit ange gardien.
            </p>

            <div style="
                text-align:center;
                color:#a17a42;
                font-size:25px;
            ">
                ✦
            </div>

        </div>

        <button class="gold-button"
                onclick="${revisit
                    ? "closeModal()"
                    : "showRules()"}">

            ${revisit
                ? "Retour à l'aventure"
                : "Découvrir les règles du jeu"}

        </button>

    `);

}


// =====================================
// JOUR 1 - ETAPE 4 : LES REGLES
// =====================================

function showRules(revisit = false) {

    showModal(`

        <div class="chapter">
            Le guide de l'aventurière
        </div>

        ${revisit ? "" : steps(4)}

        <h2>Les règles de ton aventure</h2>

        <p>
            Voici tout ce que tu dois savoir
            avant de commencer.
        </p>

        <div class="rules">

            <div class="rule">
                <strong>🎁 25 coffres à découvrir</strong>
                Un nouveau coffre chaque jour,
                du 1er au 25 décembre.
            </div>

            <div class="rule">
                <strong>🔑 24 clés à collectionner</strong>
                Chaque mission accomplie jusqu'au
                24 décembre te rapporte une clé.
            </div>

            <div class="rule">
                <strong>🔒 Pas de triche !</strong>
                Il faut terminer les missions précédentes.
                Les coffres se débloquent à partir de
                minuit, heure française, le jour prévu.
            </div>

            <div class="rule">
                <strong>🔎 Ouvre bien les yeux</strong>
                Certains indices pourront te servir
                lors de la dernière épreuve.
                Ne les oublie pas.
            </div>

            <div class="rule">
                <strong>🎮 Amuse-toi</strong>
                Tu peux recommencer les jeux
                autant de fois que nécessaire.
                Tu peux aussi rattraper les jours manqués.
            </div>

            <div class="rule">
                <strong>🏆 Le grand trésor</strong>
                Le 25 décembre, tes 24 clés te donneront
                accès au dernier secret.
            </div>

        </div>

        <p>
            Prête à devenir une véritable
            chasseuse de trésors ?
        </p>

        <button class="gold-button"
                onclick="${revisit
                    ? "closeModal()"
                    : "showProfile(false)"}">

            ${revisit
                ? "Retour"
                : "Créer mon personnage"}

        </button>

    `);

}


// =====================================
// JOUR 1 - ETAPE 5 : LE PERSONNAGE
// =====================================

function openProfile() {

    if (profile) {

        showProfile(true);

    } else {

        showModal(`
            <div class="chapter">Ton profil</div>
            <h2>Ton aventure n'a pas encore commencé.</h2>

            <p>
                Tu pourras créer ton personnage
                en terminant la première mission.
            </p>

            <button class="gold-button"
                    onclick="openDay(1)">
                Découvrir le premier coffre
            </button>
        `);

    }

}

function showProfile(edit = false) {

    editingProfile = edit;

    chosenAvatar = profile
        ? profile.avatar
        : avatars[0];

    showModal(`

        <div class="chapter">
            ${edit ? "Ton personnage" : "Création du profil"}
        </div>

        ${edit ? "" : steps(5)}

        <div class="avatar-preview" id="avatarPreview">
            ${chosenAvatar}
        </div>

        <h2>
            ${edit
                ? "Modifier mon personnage"
                : "Bienvenue, aventurière"}
        </h2>

        <p>
            Choisis le personnage qui t'accompagnera
            durant cette aventure de Noël.
        </p>

        <div class="avatar-grid" id="avatarGrid">

            ${avatars.map((avatar, i) => `
                <button
                    class="avatar-option
                    ${avatar === chosenAvatar
                        ? "selected" : ""}"
                    aria-label="Avatar ${i + 1}"
                    onclick="chooseAvatar(${i})">

                    ${avatar}

                </button>
            `).join("")}

        </div>

        <p>Quel sera ton nom d'aventurière ?</p>

        <input class="answer"
               id="nickname"
               maxlength="25"
               autocomplete="off"
               placeholder="Ton pseudo..."
               aria-label="Ton pseudo">

        <button class="gold-button"
                onclick="saveProfile()">

            ${edit
                ? "Enregistrer mon personnage"
                : "Commencer mon aventure"}

        </button>

        <div class="feedback"
             id="profileFeedback"
             aria-live="polite"></div>

    `);

    document.getElementById("nickname").value =
        profile ? profile.name : "";

}

function chooseAvatar(index) {

    chosenAvatar = avatars[index];

    document.getElementById("avatarPreview")
        .textContent = chosenAvatar;

    document.querySelectorAll(".avatar-option")
        .forEach((button, i) => {

            button.classList.toggle(
                "selected",
                i === index
            );

        });

}

function saveProfile() {

    const name =
        document.getElementById("nickname")
        .value.trim();

    if (!name) {

        document.getElementById("profileFeedback")
            .textContent =
                "Choisis un pseudo pour commencer.";

        return;

    }

    if (!editingProfile && !available(1)) return;

    profile = {
        name: name,
        avatar: chosenAvatar
    };

    saveStorage(profileKey, profile);

    updateProfileDisplay();

    if (editingProfile) {

        closeModal();
        return;

    }

    introStage = 3;

    saveStorage(introKey, introStage);

    completeDay(1);

}

function updateProfileDisplay() {

    document.getElementById("profileButton")
        .textContent = profile
            ? profile.avatar + " " + profile.name
            : "✦ NOËL 2026 ✦";

}


// =====================================
// VALIDATION DES MISSIONS
// =====================================

function completeDay(day) {

    if (!available(day)) return;

    if (!completed.includes(day)) {

        completed.push(day);
        saveStorage(storageKey, completed);

    }

    updateProgress();

    showModal(`

        <div class="chapter">Mission accomplie</div>

        <div style="width:155px;margin:25px auto">
            ${chestSVG(day === 25, true)}
        </div>

        <h2 id="successTitle">Coffre déverrouillé !</h2>

        <div style="font-size:55px;margin:20px">
            ${day === 25 ? "🎁" : "🔑"}
        </div>

        <p>
            ${day === 25
                ? "Ton aventure est terminée."
                : `Tu viens de récupérer la clé numéro ${day}.`
            }
        </p>

        ${day === 1 ? `
            <p>
                Ton personnage est créé.
                Ton aventure peut officiellement commencer.
            </p>

            <div class="rules">
                <div class="rule">
                    <strong>Prochaine mission</strong>
                    Rendez-vous le 2 décembre
                    pour découvrir ton prochain coffre.
                </div>
            </div>
        ` : ""}

        <button class="gold-button"
                onclick="closeModal()">
            Retour à mon aventure
        </button>

    `);

    if (day === 1 && profile) {

        document.getElementById("successTitle")
            .textContent =
                "Bienvenue, " + profile.name + " !";

    }

}


// =====================================
// PROGRESSION ET INVENTAIRE
// =====================================

function updateProgress() {

    const keys = completed.filter(
        day => day <= 24
    ).length;

    document.getElementById("keyCount")
        .textContent = keys;

    document.getElementById("progressText")
        .textContent = completed.length + " / 25 coffres";

    document.getElementById("progressFill")
        .style.width = completed.length / 25 * 100 + "%";

    document.getElementById("inventoryCount")
        .textContent = keys + " / 24";

    const collection =
        document.getElementById("collection");

    collection.innerHTML = "";

    for (let day = 1; day <= 24; day++) {

        const earned = completed.includes(day);

        collection.innerHTML += `
            <div class="collectible
                ${earned ? "earned" : ""}">

                <span>${earned ? "🔑" : "🔒"}</span>

                <small>Clé ${day}</small>

            </div>
        `;

    }

    renderRewards();
    renderCalendar();
    updateProfileDisplay();

}

function renderRewards() {

    const rewards = [
        [1, "Le début de l'aventure", "⭐"],
        [5, "Apprentie aventurière", "🧭"],
        [10, "Chasseuse de trésors", "💎"],
        [15, "Exploratrice confirmée", "🏅"],
        [20, "Gardienne des secrets", "👑"],
        [24, "Maîtresse des clés", "🔑"],
        [25, "Le trésor de Noël", "🏆"]
    ];

    document.getElementById("rewardList").innerHTML =
        rewards.map(([count, title, icon]) => {

            const earned = completed.length >= count;

            return `
                <div class="reward
                    ${earned ? "" : "locked"}">

                    <div style="font-size:30px">
                        ${earned ? icon : "🔒"}
                    </div>

                    <div>
                        ${title}
                        <br>
                        <small>
                            ${count} mission(s)
                            ${earned ? " — Obtenu !" : ""}
                        </small>
                    </div>

                </div>
            `;

        }).join("");

}


// =====================================
// NAVIGATION
// =====================================

function showScreen(id, button) {

    document.querySelectorAll(".screen")
        .forEach(screen =>
            screen.classList.remove("active")
        );

    document.getElementById(id)
        .classList.add("active");

    document.querySelectorAll(".nav-button")
        .forEach(item =>
            item.classList.remove("active")
        );

    button.classList.add("active");

    window.scrollTo(0, 0);

}

function showModal(content) {

    document.getElementById("modalContent")
        .innerHTML = content;

    document.getElementById("overlay")
        .classList.add("visible");

    document.querySelector(".modal").scrollTop = 0;

    document.body.style.overflow = "hidden";

}

function closeModal() {

    document.getElementById("overlay")
        .classList.remove("visible");

    document.body.style.overflow = "";

}

document.getElementById("overlay")
    .addEventListener("click", event => {

        if (event.target.id === "overlay") {
            closeModal();
        }

    });

document.addEventListener("keydown", event => {

    if (event.key === "Escape") {
        closeModal();
    }

    if (
        document.getElementById("codeDisplay") &&
        document.getElementById("overlay")
            .classList.contains("visible")
    ) {

        if (/^[0-9]$/.test(event.key)) {
            pressDigit(event.key);
        }

        if (event.key === "Backspace") {
            deleteDigit();
        }

        if (event.key === "Enter") {
            checkFirstCode();
        }

    }

});


// =====================================
// REINITIALISATION DU MODE TEST
// =====================================

function resetTest() {

    if (!testMode) return;

    if (!confirm("Réinitialiser uniquement ta progression de test ?")) {
        return;
    }

    try {
        localStorage.removeItem(storageKey);
        localStorage.removeItem(profileKey);
        localStorage.removeItem(introKey);
    } catch (error) {
        alert("Impossible de réinitialiser le stockage.");
        return;
    }

    location.reload();

}


// =====================================
// DEMARRAGE
// =====================================

updateProgress();

setInterval(renderCalendar, 30000);

</script>

